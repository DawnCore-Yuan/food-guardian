{
  "name": "food-guardian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:leaderboard": "node --test scripts/leaderboard-logic.test.mjs scripts/leaderboard-rules.test.mjs",
    "verify:leaderboard": "node scripts/leaderboard-verify.mjs",
    "build:pages": "npm run build"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "typescript": "5.7.2",
    "vite": "6.3.1"
  }
}
